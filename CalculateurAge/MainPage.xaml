<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             x:Class="CalculateurAge.MainPage"
             Title="Calculateur">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="12">
            <Label Text="Nom"
                   FontSize="16"/>
            <Entry x:Name="entryNom" Placeholder="entrez votre nom"/>
            <Label Text="Date de naissance" FontSize="16"/>
            <DatePicker x:Name="PickerDate" MaximumDate="{x:Static sys:DateTime.Now}" />
            <Button  x:Name="btnCalculer" 
                     Text="Calculer l'age"
                     Clicked="onCalculerClicked"/>
            <Label x:Name="lblResultat" 
                   FontSize="20"
                   IsVisible="Hidden"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
